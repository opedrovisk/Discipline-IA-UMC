        "// Ex 21 - Busca Binária\n",
        "static int BuscaBinaria(int[] lista, int alvo)\n",
        "{\n",
        "    int inicio = 0;\n",
        "    int fim = lista.Length - 1;\n",
        "\n",
        "    while (inicio <= fim)\n",
        "    {\n",
        "        int meio = (inicio + fim) / 2;\n",
        "\n",
        "        if (lista[meio] == alvo)\n",
        "            return meio;\n",
        "        else if (lista[meio] < alvo)\n",
        "            inicio = meio + 1;\n",
        "        else\n",
        "            fim = meio - 1;\n",
        "    }\n",
        "\n",
        "    return -1;\n",
        "}\n",
